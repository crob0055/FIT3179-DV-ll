{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#faf9f4",
  "title": {
    "text": "Snow seasons at Spencers Creek",
    "subtitle": [
      "Each ridge shows recorded snow depth through one year, 1954\u20132025.",
      "All ridges share a 0\u2013400 cm scale. Higher peaks mean deeper snow.",
      "Lines join irregular readings; gaps are not evidence of zero snow."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 12,
    "offset": 40
  },
  "data": {
    "url": "spencers-creek-seasonal.json"
  },
  "facet": {
    "row": {
      "field": "year",
      "type": "ordinal",
      "sort": "ascending",
      "header": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 10,
        "labelExpr": "datum.value % 5 == 0 || datum.value == 1954 ? datum.label : ''"
      }
    }
  },
  "spacing": 0,
  "bounds": "flush",
  "spec": {
    "mark": {
      "type": "area",
      "interpolate": "linear",
      "fillOpacity": 0.8,
      "stroke": "#faf9f4",
      "strokeWidth": 0.6,
      "orient": "vertical"
    },
    "encoding": {
      "x": {
        "field": "season_date",
        "type": "temporal",
        "scale": {
          "domain": [
            "2000-01-01",
            "2000-12-31"
          ]
        },
        "axis": {
          "title": "Month",
          "format": "%b",
          "tickCount": 12,
          "grid": false
        }
      },
      "y": {
        "field": "depth_cm",
        "type": "quantitative",
        "scale": {
          "domain": [
            0,
            400
          ],
          "range": [
            10,
            -35
          ]
        },
        "axis": null,
        "stack": null
      },
      "color": {
        "field": "year",
        "type": "quantitative",
        "scale": {
          "scheme": "blues",
          "domain": [
            1954,
            2025
          ]
        },
        "legend": null
      },
      "tooltip": [
        {
          "field": "year",
          "type": "quantitative",
          "format": "d"
        },
        {
          "field": "season_date",
          "type": "temporal",
          "title": "Month/day",
          "format": "%d %b"
        },
        {
          "field": "depth_cm",
          "type": "quantitative",
          "title": "Depth (cm)"
        }
      ]
    },
    "width": 760,
    "height": 10
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial",
      "color": "#233a35"
    }
  },
  "usermeta": {
    "source": "https://www.snowyhydro.com.au/generation/live-data/snow-depths/",
    "comments": {
      "ridges": "One year per row; shared depth scale with overlapping vertical range. This depicts seasonal depth profiles, not probability density.",
      "dates": "Mapped month/day to leap year 2000 solely to align seasons. Tooltips retain real dates.",
      "missing": "Only observations plotted; no zero filling, extrapolation or smoothing. Straight lines between samples are visual guides.",
      "scope": "Single alpine site, not Australian snowfall. Incomplete 2026 omitted."
    }
  }
}