{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 350,
  "background": "#faf9f4",
  "title": {
    "text": "Are wet and dry years becoming more variable?",
    "subtitle": [
      "Box: middle half of annual totals. Centre line: median.",
      "Dots show recorded years, including values beyond the whiskers."
    ],
    "anchor": "start",
    "fontSize": 21,
    "subtitleFontSize": 12,
    "offset": 18
  },
  "data": {
    "url": "rainfall-boxplot.json"
  },
  "params": [
    {
      "name": "city",
      "value": "Perth",
      "bind": {
        "input": "select",
        "options": [
          "Adelaide",
          "Darwin",
          "Hobart",
          "Melbourne",
          "Perth"
        ],
        "name": "City: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.city == city"
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "nominal",
      "sort": [
        "1970\u20131997",
        "1998\u20132025"
      ],
      "axis": {
        "title": null,
        "labelAngle": 0
      }
    },
    "y": {
      "field": "annual_mm",
      "type": "quantitative",
      "title": "Annual rainfall (mm)",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "period",
      "type": "nominal",
      "scale": {
        "domain": [
          "1970\u20131997",
          "1998\u20132025"
        ],
        "range": [
          "#97bdbb",
          "#246f74"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 85,
        "outliers": false,
        "median": {
          "color": "#172f32"
        },
        "box": {
          "opacity": 0.75
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 38,
        "opacity": 0.55,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "city",
            "title": "City"
          },
          {
            "field": "station",
            "title": "Station"
          },
          {
            "field": "year",
            "type": "quantitative",
            "format": "d",
            "title": "Year"
          },
          {
            "field": "annual_mm",
            "type": "quantitative",
            "format": ".1f",
            "title": "Annual rainfall (mm)"
          },
          {
            "field": "pending_months",
            "type": "quantitative",
            "title": "Months awaiting quality control"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "period"
          ]
        },
        {
          "calculate": "'n = ' + datum.n + ' complete years'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 12,
        "color": "#233a35"
      },
      "encoding": {
        "y": {
          "value": 0
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#233a35"
        }
      }
    }
  ],
  "usermeta": {
    "comments": {
      "data": "Only 12-month complete years; real annual sums from the existing rainfall dataset. Pending quality-control months retained and reported in point tooltips.",
      "coverage": "Equal 28-year calendar periods; only cities with >=15 complete years in each are selectable. Sample sizes differ; missingness may bias comparisons.",
      "box": "Standard Tukey box plot: Q1 to Q3, median, whiskers to most extreme observations within 1.5 IQR. Points include all values, including outliers.",
      "position": "Points centred within each period; overlapping identical values remain coincident.",
      "interpretation": "Station observations, not city-wide averages. Descriptive comparison, not a significance test."
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#e1e5df"
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial",
      "color": "#233a35"
    }
  }
}